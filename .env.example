# Public origin of the instance. Passkeys are bound to it — changing it invalidates them.
ORIGIN=http://localhost:8080
RP_ID=localhost
RP_NAME=GymBuddy
WEB_PORT=8080

# Signs session cookies. Generate with: openssl rand -hex 32
# Required in production: without it a fresh one is made on every restart, which signs
# everyone out each time the container is replaced.
SESSION_SECRET=

# Database. The compose file builds this URL for you; set it only when pointing at your own.
POSTGRES_USER=gymbuddy
POSTGRES_PASSWORD=gymbuddy
POSTGRES_DB=gymbuddy
# DATABASE_URL=postgres://gymbuddy:gymbuddy@db:5432/gymbuddy

# Create a demo coach and three clients on first boot, so there is something to look at.
# Leave empty for a real instance.
SEED_DEMO=1

# Require an invite code to create an account.
INVITE_ONLY=false

# Rate limiting. On by default, and worth leaving on for anything reachable from the internet:
# the drafting endpoints call a language model, so an unthrottled loop spends your money.
# Requests are counted against the signed-in account rather than the IP address — many users
# share one carrier address, and counting by address lets one of them lock out the rest.
# Turn off for a single-user instance on your own hardware.
RATE_LIMIT=on
# Session lifetime in days.
SESSION_DAYS=90

# Language model. Entirely optional: with no key, plans, reviews and text logging all still work
# — the wording comes from a template instead of prose. Nothing numeric ever comes from a model.
#
# Two tiers. FAST answers the jobs the domain validates afterwards (reading a description into a
# brief, rewriting a messy log into shorthand the parser re-reads). DEEP writes the note a coach
# sends to a client — the one piece of model output a person reads verbatim, so it is worth the
# better model, and it is a few hundred tokens at a time.
#
# Set the model ids to the exact strings your provider lists; these are what they are called at
# the time of writing and vendors rename them.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# GYMBUDDY_MODEL_FAST=deepseek-v4-flash
# GYMBUDDY_MODEL_DEEP=deepseek-v4-pro

# Anthropic instead, if you have it. Same two variables apply.
# ANTHROPIC_API_KEY=
# GYMBUDDY_AI_MODEL=claude-sonnet-4-5

# Models on your own hardware, via Ollama's OpenAI-compatible endpoint.
#
# With a hosted key set above, this is the failover: it answers when the hosted model cannot be
# reached, which is what an outage, a lapsed key and a blocked route all look like from here.
# With no hosted key, it stops being a failover and becomes the model.
#
# Expect Persian prose from a small local model to be noticeably worse than from a hosted one —
# the point of this path is that the product keeps working, not that it works identically.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL_FAST=qwen3:8b
# OLLAMA_MODEL_DEEP=qwen3:32b

# Web push. Generate a pair with:  npx web-push generate-vapid-keys
# Set these once and keep them: changing them silently breaks every existing subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost
