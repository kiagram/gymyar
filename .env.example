# Public origin of the instance. Passkeys are bound to it — changing it invalidates them.
ORIGIN=http://localhost:8080
RP_ID=localhost
RP_NAME=GymBuddy

WEB_PORT=8080

# Comma-separated user ids with access to the admin dashboard. Empty = no admin.
ADMIN_UIDS=
# Require an invite code to create a profile.
INVITE_ONLY=false
# Session lifetime in days.
SESSION_DAYS=90

# mailto: or https: URL identifying the push sender. Defaults to ORIGIN over https.
VAPID_SUBJECT=

# --- phase 2 ---
# DATABASE_URL=postgres://gymbuddy:gymbuddy@db:5432/gymbuddy
