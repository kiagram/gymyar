# Public origin of the instance. Passkeys are bound to it — changing it invalidates them.
ORIGIN=http://localhost:8080
RP_ID=localhost
RP_NAME=GymBuddy
WEB_PORT=8080

# Signs session cookies. Generate with: openssl rand -hex 32
# Required in production: without it a fresh one is made on every restart, which signs
# everyone out each time the container is replaced.
SESSION_SECRET=

# Database. The compose file builds this URL for you; set it only when pointing at your own.
POSTGRES_USER=gymbuddy
POSTGRES_PASSWORD=gymbuddy
POSTGRES_DB=gymbuddy
# DATABASE_URL=postgres://gymbuddy:gymbuddy@db:5432/gymbuddy

# Create a demo coach and three clients on first boot, so there is something to look at.
# Leave empty for a real instance.
SEED_DEMO=1

# Require an invite code to create an account.
INVITE_ONLY=false
# Session lifetime in days.
SESSION_DAYS=90

# Web push. Generate a pair with:  npx web-push generate-vapid-keys
# Set these once and keep them: changing them silently breaks every existing subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost
