# Public origin of the instance. Passkeys are bound to it — changing it invalidates them.
ORIGIN=http://localhost:8080
RP_ID=localhost
RP_NAME=GymYar
WEB_PORT=8080

# Signs session cookies. Generate with: openssl rand -hex 32
# Required in production: without it a fresh one is made on every restart, which signs
# everyone out each time the container is replaced.
SESSION_SECRET=

# Database. The compose file builds this URL for you; set it only when pointing at your own.
POSTGRES_USER=gymyar
POSTGRES_PASSWORD=gymyar
POSTGRES_DB=gymyar
# DATABASE_URL=postgres://gymyar:gymyar@db:5432/gymyar

# Create a demo coach and three clients on first boot, so there is something to look at.
# Leave empty for a real instance.
SEED_DEMO=1

# Require an invite code to create an account.
INVITE_ONLY=false

# The counters on the project site at `/` — accounts, coaches, finished sessions, working
# sets, tonnage, library size. Read from this instance's own database and served to anybody
# without a session, which is the point: the numbers on the front page are the instance
# rather than a claim somebody typed.
#
# Aggregates only. No row, no name, no address, and nothing that narrows to one person — see
# apps/api/src/routes/public.js, which is deliberately the one route file with no session
# check in it. Warm-up sets and unfinished sessions are left out.
#
# Turn it off for a household instance that would rather not publish how few people are on
# it. The route then does not exist, and the site simply omits that section.
PUBLIC_STATS=on

# Rate limiting. On by default, and worth leaving on for anything reachable from the internet:
# the drafting endpoints call a language model, so an unthrottled loop spends your money.
# Requests are counted against the signed-in account rather than the IP address — many users
# share one carrier address, and counting by address lets one of them lock out the rest.
# Turn off for a single-user instance on your own hardware.
RATE_LIMIT=on
# Session lifetime in days.
SESSION_DAYS=90

# Language model. Entirely optional: with no key, plans, reviews and text logging all still work
# — the wording comes from a template instead of prose. Nothing numeric ever comes from a model.
#
# Two tiers. FAST answers the jobs the domain validates afterwards (reading a description into a
# brief, rewriting a messy log into shorthand the parser re-reads). DEEP writes the note a coach
# sends to a client — the one piece of model output a person reads verbatim, so it is worth the
# better model, and it is a few hundred tokens at a time.
#
# Set the model ids to the exact strings your provider lists; these are what they are called at
# the time of writing and vendors rename them.
#
# OpenAI. Checked before the other hosted keys, so a key left over from a previous vendor does
# not quietly keep answering. Note that a reasoning model spends its budget on thinking before
# it writes anything, which is why this path asks for a larger one — see openai-compat.js.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# GYMYAR_MODEL_FAST=gpt-5-mini
# GYMYAR_MODEL_DEEP=gpt-5
#
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# GYMYAR_MODEL_FAST=deepseek-v4-flash
# GYMYAR_MODEL_DEEP=deepseek-v4-pro

# Anthropic instead, if you have it. Same two variables apply.
# ANTHROPIC_API_KEY=
# GYMYAR_AI_MODEL=claude-sonnet-4-5

# Models on your own hardware, via Ollama's OpenAI-compatible endpoint.
#
# With a hosted key set above, this is the failover: it answers when the hosted model cannot be
# reached, which is what an outage, a lapsed key and a blocked route all look like from here.
# With no hosted key, it stops being a failover and becomes the model.
#
# Expect Persian prose from a small local model to be noticeably worse than from a hosted one —
# the point of this path is that the product keeps working, not that it works identically.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL_FAST=qwen3:8b
# OLLAMA_MODEL_DEEP=qwen3:32b

# The model that may be shown a photograph, for `POST /api/ai/form-check/:id` — a form check a
# person filed against a lift, and what is visible in it about the movement.
#
# There is no hosted equivalent of this variable and that is deliberate. These pictures are
# somebody in a gym, uploaded so their coach could look at a rep; sending them to a vendor is a
# different act from sending that vendor the sentence "bench press stalled", and nobody agreed
# to it when they uploaded a form check. So the image path stops at OLLAMA_BASE_URL. Unset this
# and the feature is gone — /api/ai/status reports `vision: false` and the app hides it, which
# is also the switch to reach for if you would rather not run this at all.
#
# Progress photos are never sent to any model, configured or not: the endpoint refuses that
# subject outright. A machine's opinion of how somebody looks is not something this builds.
#
# Expect a 7B vision model to be roughly right about where a bar is and wrong about anything
# subtle. It is a second pair of eyes for a coach to argue with, not a verdict — and on a CPU
# it takes tens of seconds per photograph.
# OLLAMA_MODEL_VISION=qwen2.5-vl:7b

# The largest photograph handed to that model. Lower than MAX_PHOTO_BYTES on purpose: the object
# is read whole into the API process and base64 makes it a third larger again, and Ollama scales
# the image down to what the model takes anyway, so a bigger file costs the copy and buys no
# detail. Default 4 MiB.
# MAX_VISION_BYTES=4194304

# Web push. Generate a pair with:  npx web-push generate-vapid-keys
# Set these once and keep them: changing them silently breaks every existing subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost

# ---------------------------------------------------------------- billing ----
#
# Off unless you set a merchant id. With it unset, coaching is free on this instance and no
# subscription row is ever written — which is what a self-hosted GymYar should be. The paid
# tier is a property of a deployment, not of the software.
#
# What is free either way: training. Logging, programmes, history and stats are never gated.
# What the subscription buys is the coach side — taking on clients, proposing programmes to
# them, and messaging them. A client never pays and is never blocked, including when their
# coach's subscription lapses.
#
# Zarinpal is the only gateway implemented. It has no recurring billing and no webhooks, so a
# subscription here is a paid-through date that a purchase extends, and payments are confirmed
# when the payer's browser returns to /api/billing/callback. Some never return — see
# `stalePayments()` in packages/db/src/billing.js for the reconciliation those need.
# ZARINPAL_MERCHANT_ID=
#
# Point at Zarinpal's sandbox while you are wiring this up. Nothing settles there.
# ZARINPAL_SANDBOX=1
#
# What the terminal is denominated in. IRR is Rials and is the usual default; set IRT only if
# your terminal is configured in Toman. Getting this wrong is a factor-of-ten billing error.
# BILLING_CURRENCY=IRR
#
# Prices, in TOMAN, per tier and term. The defaults in apps/api/src/payments/pricing.js are
# placeholders, not a recommendation — set real ones before taking a real payment.
#
# Three tiers, which differ only in how many clients a coach may take on: solo is 5, studio 25,
# pro 100. The caps themselves are not configurable here — they are part of what was sold and
# live in packages/domain/src/entitlement.js, so that the number on the price card and the
# number that gets enforced cannot drift apart.
# PRICE_SOLO_1M=149000
# PRICE_SOLO_3M=399000
# PRICE_SOLO_12M=1290000
# PRICE_STUDIO_1M=349000
# PRICE_STUDIO_3M=939000
# PRICE_STUDIO_12M=2990000
# PRICE_PRO_1M=749000
# PRICE_PRO_3M=1999000
# PRICE_PRO_12M=6490000
#
# The unprefixed names below are what this file carried before tiers existed. They still work,
# and they price the *solo* tier — the smallest thing on sale, and the only tier a single flat
# price could have meant. A tier-specific name wins over one of these when both are set.
# PRICE_1M=149000
# PRICE_3M=399000
# PRICE_12M=1290000
#
# ── Holding the value of that price list ────────────────────────────────────────
#
# A fixed Toman price is not a price. It is a slow discount nobody approved: the costs behind
# it are in dollars — model tokens, hosting, the exercise-media licence — and the rial has been
# falling against all of them. In one week of August 2026 the open-market dollar went from
# about 186,500 Toman to 203,200, and the annual term above was worth roughly six dollars for a
# year of service by the end of it. The longer the term, the worse it is, which is backwards.
#
# So the list above is *indexed* rather than edited. Say what the dollar was worth when you
# wrote those numbers, and what it is worth now, and every price moves with the ratio. Leave
# both unset and nothing is indexed — prices are exactly the numbers above, which is the right
# behaviour for an instance that does not charge anybody.
#
# PRICE_BASELINE_TOMAN_PER_USD  the rate the price list above was written at. Change this only
#                               when you rewrite the prices themselves.
# TOMAN_PER_USD                 the rate today, open market. This is the one you update.
# TOMAN_PER_USD_AT              when you read it, ISO 8601. Not optional in practice — see below.
# PRICE_BASELINE_TOMAN_PER_USD=203200
# TOMAN_PER_USD=203200
# TOMAN_PER_USD_AT=2026-08-25
#
# Nothing here is fetched. A checkout that depends on an outbound call to a rate service is a
# checkout that fails when that service is down, blocked or slow, and in this market all three
# are ordinary. Update these by hand, or have a job write them; the software does not care.
#
# ── Cadence ─────────────────────────────────────────────────────────────────────
#
# Update TOMAN_PER_USD and TOMAN_PER_USD_AT together, weekly, from whatever open-market source
# you trust (bonbast.com and alanchand.com are the usual ones). It takes a minute and it is the
# whole maintenance burden of this design.
#
# If you stop, the instance notices. A rate older than RATE_MAX_AGE_DAYS is treated as stale,
# and a stale rate withdraws every term except the shortest — so the exposure is capped at one
# month instead of compounding for a year. Prices are NOT reverted to the unindexed numbers
# when that happens: the last known rate is closer to the truth than pretending the currency
# never moved. A rate with no TOMAN_PER_USD_AT counts as stale immediately, because "we have a
# rate but will not say when it was true" is not a stronger claim than having none.
# RATE_MAX_AGE_DAYS=7
#
# A configured pair implying the list should move by more than fiftyfold, or less than a fifth,
# is read as a typo rather than a currency: the index is ignored and the terms are restricted,
# so a mistyped rate cannot charge anybody fifty times.

# ---------------------------------------------------------------- media ----
#
# Form-check video, progress photos and voice notes. This is the first user data GymYar keeps
# outside Postgres, which changes one thing in section 7 of docs/SELF_HOSTING.md: "the database
# is the backup" stops being the whole truth. A pg_dump holds every row describing these files
# and none of their bytes.
#
# STORAGE_DRIVER  fs (default) or s3.
#
# `fs` is a directory on a volume, served by the nginx that is already in front of the app. It
# is the default because S3, R2 and the CDNs in front of them are not reachable from an Iranian
# entity — an account you cannot open, rather than a latency you could tune around.
#
# `s3` is a stub. It validates its configuration and every method throws; the interface is real
# and the bodies are an afternoon's work. See packages/storage/src/s3.js. Useful if you are
# outside that problem, or want to point MinIO at the same machine.
# STORAGE_DRIVER=fs
#
# Where the files go. Inside the container by default, on the `media` volume that
# docker-compose.yml mounts at this path. Change it and change the mount to match.
# STORAGE_PATH=/data/media
#
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
# STORAGE_S3_ENDPOINT=          # for MinIO or a non-AWS S3
# STORAGE_S3_PREFIX=
#
# ── Limits ──────────────────────────────────────────────────────────────────────
#
# Per upload, in bytes. The phone compresses before sending and stops recording at
# MAX_VIDEO_SECONDS, so these are the backstop rather than the thing a person meets — a
# rejection after a 40 MB upload on mobile data is a churned user, not a helpful error.
#
# Set them against what bandwidth costs you. A coach reviewing thirty clients a week at 60 MB a
# clip is a bigger number than the subscription that coach is paying.
# MAX_PHOTO_BYTES=8388608
# MAX_VIDEO_BYTES=62914560
# MAX_AUDIO_BYTES=8388608
# MAX_VIDEO_SECONDS=60
#
# ── Signed links ────────────────────────────────────────────────────────────────
#
# Nothing under STORAGE_PATH is servable without a signature. The API decides who may see a
# file — owner, or a coach whose client granted the scope — and the answer is a URL that stops
# working within minutes, because a signed URL is a bearer token that ends up in browser
# history, proxy logs and referrers.
#
# The signing key is derived from SESSION_SECRET through a fixed label, so it rotates with it
# and a leaked media link is never a forged session. Set this only if you want media links and
# sessions to rotate independently; a second secret is a second thing to lose.
# STORAGE_URL_SECRET=
#
# How long one of those links lasts, in seconds. Long enough to start playing a video, short
# enough that a link left in a browser history or a proxy log is a curiosity rather than an
# exposure. Raise it if people are watching hour-long clips; there is no reason to.
# MEDIA_URL_TTL=300
#
# ── Serving ─────────────────────────────────────────────────────────────────────
#
# STORAGE_ACCEL: hand finished requests to nginx instead of streaming them from Node.
#
# On (docker-compose sets it), the API verifies the signature and answers with an empty body
# and an `X-Accel-Redirect` header; nginx reads the file off the same volume and streams it,
# ranges included. Off, Node serves the bytes itself — which is what the dev stack and the test
# suite do, and what any deployment without nginx in front has to do.
#
# Turning it on without an nginx configured for it produces empty responses, so it is a
# property of the stack rather than a performance dial to reach for.
# STORAGE_ACCEL=
#
# ── Per account ─────────────────────────────────────────────────────────────────
#
# Everything one account may hold at once, in bytes. 0 is unlimited, which is the right answer
# for an instance you and your family use and the wrong one for anything with an open signup
# form: an upload endpoint with no ceiling is a storage bill somebody else gets to write.
#
# Checked before an upload starts, against what is already stored — so a single file may cross
# the line and the next one is refused. 2 GB is roughly thirty form checks and a few hundred
# photographs.
# MAX_MEDIA_BYTES_PER_USER=2147483648

# ------------------------------------------------------------------- sms ----
#
# Signing up and signing in with an Iranian mobile number: a code by SMS, and no password.
#
# This is the door most of this product's users will come through. A passkey needs a device and
# a browser that will do WebAuthn; an email address in Iran is largely a thing you keep in order
# to sign up to foreign services, and the reset email above has to cross a border, from a relay
# whose reputation is not yours, into filters that distrust the whole origin. A phone number is
# the identifier this market actually uses, and a domestic gateway is the one delivery channel
# that is not somebody else's geopolitics.
#
# SMS_TRANSPORT  unset (default) · kavenegar · smsir · log
#
# Unset means this instance cannot text anybody, and phone sign-in is not offered at all: the
# API reports it off, the app does not render the button, and the endpoints refuse with a 501.
# The same honest shape as MAIL_TRANSPORT — passkeys and passwords are unaffected either way.
#
# `log` writes the code to the server log instead of sending it. That is for the household
# instance: one person, their own server, no gateway, and they are the one reading the logs. On
# an instance with users it means every sign-in code passes through whatever ships those logs,
# which is a sentence worth reading twice before setting it.
# SMS_TRANSPORT=
#
# ── The pattern is not optional in practice ─────────────────────────────────────
#
# Both gateways below deliver one-time codes through a *pattern*: a message body you register
# with them, with a slot for the code, approved by the operator before it will send. That is not
# a quirk of their APIs. An unregistered bulk message to an Iranian handset is filtered,
# deprioritised or dropped outright, and a signup whose SMS arrives eleven minutes later is a
# signup that does not work.
#
# So register a pattern, wait for approval — it takes days — and set the id below. Leave it
# unset and the code goes out as a plain message instead, which exists so you can see the whole
# flow work while you are waiting rather than being blocked on somebody else's queue. It is a
# temporary state, not a configuration.
#
# The text GymYar composes when it composes one at all is in packages/sms/src/templates.js.
# Register a pattern that says the same thing: the code, who it is from, and five minutes.
#
# ── Kavenegar ───────────────────────────────────────────────────────────────────
#
# SMS_KAVENEGAR_KEY        the API key from your panel
# SMS_KAVENEGAR_TEMPLATE   the pattern's name, e.g. gymyar-otp. Uses verify/lookup.
# SMS_KAVENEGAR_SENDER     a line number, only for the unregistered fallback path
# SMS_KAVENEGAR_KEY=
# SMS_KAVENEGAR_TEMPLATE=
# SMS_KAVENEGAR_SENDER=
#
# ── SMS.ir ──────────────────────────────────────────────────────────────────────
#
# SMS_SMSIR_KEY            the API key, sent as X-API-KEY
# SMS_SMSIR_TEMPLATE_ID    the pattern's numeric id. Uses send/verify.
# SMS_SMSIR_PARAM          the name of the slot in that pattern. Default CODE — it is chosen
#                          when you register the pattern, so set it to whatever you called it.
# SMS_SMSIR_LINE           a line number, only for the unregistered fallback path
# SMS_SMSIR_KEY=
# SMS_SMSIR_TEMPLATE_ID=
# SMS_SMSIR_PARAM=CODE
# SMS_SMSIR_LINE=
#
# ── What the message calls this instance ────────────────────────────────────────
#
# Defaults to RP_NAME. Set it to the sender name the operator approved, if that differs — the
# name in the text and the name on the message have to be the same thing or it reads as a
# phishing attempt, which is exactly what a person should be suspicious of.
# SMS_BRAND=
#
# ── Ceilings ────────────────────────────────────────────────────────────────────
#
# Not configurable, on purpose. A code lasts five minutes and the message says so; one number
# may be texted once a minute and five times a day; one code survives five wrong guesses. Every
# one of those numbers is either stated to the person or is the thing standing between your SMS
# balance and somebody who noticed the endpoint. They live in packages/db/src/phone-codes.js.
#
# The codes are stored as HMAC(key, phone + code) and never in the clear, with the key derived
# from SESSION_SECRET — so rotating that secret invalidates every outstanding code, which costs
# somebody one resend. Set PHONE_CODE_SECRET only if you want the two to rotate independently;
# a second secret is a second thing to lose.
# PHONE_CODE_SECRET=

# ----------------------------------------------------------------- email ----
#
# GymYar sends two: a password reset link, and a code confirming that whoever typed an address
# can read it. There is no newsletter, no notification digest and nothing else planned — Web
# Push handles the things that need to reach somebody, and it needs no relay.
#
# The confirmation matters more than it looks. `email_verified_at` shipped in the very first
# migration and nothing ever wrote it, so on any instance older than this one *every* address is
# unproven and anybody could always have signed up with somebody else's. Signing up still works
# without confirming — the account is created, the session is issued, and the code goes out
# behind it — but "forgot password" now requires a confirmed address, because that is the one
# endpoint that mails a way into an account. Existing addresses were grandfathered by migration
# 011, so nobody who could reset yesterday is refused today.
#
# MAIL_TRANSPORT  unset (default) · smtp · log
#
# Unset means this instance cannot send email, and neither password reset nor confirming an
# address is offered at all: the API reports both off, the app renders neither, and the
# endpoints refuse with a 501. An account can still be created with an address and a password —
# it simply stays unconfirmed, and has no way back in if the password is forgotten.
# That is deliberate rather than degraded — an instance with no relay genuinely cannot reset a
# password, and a form that says "check your inbox" to somebody who will never receive anything
# is worse than no form. Passkeys are unaffected either way.
#
# `log` writes the message to the server log instead of sending it. That is for the household
# instance: one person, their own server, no relay, and they are the one reading the logs. On an
# instance with users it means every reset link passes through whatever ships those logs, which
# is a sentence worth reading twice before setting it.
# MAIL_TRANSPORT=
#
# ── SMTP ────────────────────────────────────────────────────────────────────────
#
# Any relay: your own, your host's, or a transactional provider. Port 587 with STARTTLS is the
# usual answer and is what the port defaults to; 465 is implicit TLS and turns MAIL_SMTP_SECURE
# on by itself, so the two do not normally need setting together.
#
# On the non-secure port, STARTTLS is *required* rather than attempted. A relay that will not
# upgrade the connection is one that would otherwise receive this password in the clear, and a
# connection error is the right outcome there.
# MAIL_SMTP_HOST=
# MAIL_SMTP_PORT=587
# MAIL_SMTP_USER=
# MAIL_SMTP_PASS=
# MAIL_SMTP_SECURE=              # only to override what the port implies
#
# Who the message is from. A full "Name <address>" is fine. Use an address on a domain whose
# SPF and DKIM you control, or the mail will be delivered to a spam folder and the feature will
# look broken rather than misconfigured.
# MAIL_FROM=GymYar <no-reply@example.com>
#
# ── The link ────────────────────────────────────────────────────────────────────
#
# Reset links are built from ORIGIN, which is set further up for passkeys and is the same value.
# An instance still on the default localhost origin will email links that only work on the
# machine they were sent from — which is the same sentence as "set ORIGIN before anybody else
# signs up".
#
# The link is good for one hour and works once. Neither is configurable: the expiry is stated in
# the email in thirteen languages, and a setting that changes one without the other is a setting
# that makes the email lie.
