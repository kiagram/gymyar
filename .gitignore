node_modules/
dist/
.env

# Runtime instance state — session secret, VAPID private key, user records.
# The GitHub re-upload of openGym committed these; never do that.
data/

# Exercise media is © Gym visual and is fetched at build time, never committed.
media/

.DS_Store
*.log
apps/client/ios/App/Pods/
apps/client/android/.gradle/
apps/client/android/app/build/

# Agent worktrees — full checkouts of this repo, registered with `git worktree`.
.claude/worktrees/

# Android release signing. The keystore identifies the app to every device that has it
# installed — losing it means no user can ever update again, and leaking it means anyone
# can ship an update. Back it up somewhere that is not a git repository.
apps/client/android/keystore.properties
*.keystore
*.jks

# Built APKs. `assembleDebug` drops a 6 MB artifact into the tree on every build, and a
# signed release one is a shippable binary that belongs on the site, not in the history.
*.apk

# Deploy-time assets for the project site: screenshots, banner and icons are copied in
# from assets/ and apps/client/public/ rather than duplicated in the tree. See apps/site/README.md.
apps/site/img/
apps/site/icon-180.png
apps/site/icon-512.png

# Local scratch volume for uploaded media in development (see STORAGE_PATH in .env)
.devmedia/
