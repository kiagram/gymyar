# Loaded by `vite build --mode mobile`. Vite picks up .env.[mode] automatically and exposes
# every VITE_-prefixed value to the bundle.
#
# This is a file rather than a `VAR=value vite build` prefix in package.json because that
# prefix is shell syntax, and npm runs scripts through cmd.exe on Windows, where it is a
# syntax error. `npm run sync:mobile` was documented in two places and could not run there.

# There is no backend in this build: no accounts, no sync, no coaching, no payments.
VITE_MOBILE=1

# Exercise media comes from a CDN rather than from a server this build does not have.
#
# Worth being clear about what this is: jsDelivr serving a third party's GitHub repository of
# © Gym visual artwork, into an app that ships to people. The hosted instance at least copies
# the files onto its own volume; this build hotlinks them, so the exposure is redistribution
# rather than use, and it depends on a stranger's repository staying where it is. Both are
# reasons the media licence is a launch blocker — see the note in README.md and the set in
# packages/domain/src/media-set.js, which is what a replacement changes.
VITE_IMG_BASE=https://cdn.jsdelivr.net/gh/hasaneyldrm/exercises-dataset@7455efae41b330c265e7cd4b78dfa848e7ce5ebd/images/
VITE_GIF_BASE=https://cdn.jsdelivr.net/gh/hasaneyldrm/exercises-dataset@7455efae41b330c265e7cd4b78dfa848e7ce5ebd/videos/
